# Kopieren nach .env und Werte setzen. Die .env wird nie eingecheckt.
DJANGO_SECRET_KEY=hier-einen-langen-zufallswert-eintragen
DJANGO_DEBUG=false
# Name des Servers im Tailscale-Netz, z. B. cockpit.tailnet-name.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Lokal ohne HTTPS: false. Hinter Tailscale-HTTPS: true.
DJANGO_SECURE_COOKIES=false
POSTGRES_HOST=db
POSTGRES_DB=cockpit
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=bitte-aendern
